# This is the ONLY frontend configuration value and must contain only a
# public API base URL — never an API key, service key, or any other secret.
# Empty for local development: Vite proxies /api to the Worker target in vite.config.ts.
# In Cloudflare Pages production, set this to the deployed Worker base URL, e.g.:
# VITE_API_BASE_URL=https://warungkit-api.anotechhub.workers.dev
VITE_API_BASE_URL=

# Keep false until P8 checkout + Mayar integration is implemented and tested.
VITE_CHECKOUT_ENABLED=false

# Optional local-only Vite proxy override. Never use this for secrets.
VITE_PROXY_TARGET=https://warungkit-api.anotechhub.workers.dev
