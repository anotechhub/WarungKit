{
  "name": "@warungkit/api",
  "version": "0.0.0",
  "private": true,
  "description": "WarungKit backend API — Hono on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings src/types/bindings.gen.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@warungkit/contracts": "workspace:*",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260701.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
